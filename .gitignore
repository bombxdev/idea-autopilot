# personal data — never commit to the public app repo
data/
workspace/ideas/
workspace/inbox/
workspace/knowledge/
brain/
screenshots/

# build output
bin/*.exe
dist/
app/node_modules/
app/dist/
app/src-tauri/target/
app/src-tauri/target-dist/
# sidecar copies of the ia CLI made by scripts/package.sh and CI (<name>-<target triple>)
app/src-tauri/binaries/
app/src-tauri/gen/
mobile/.gradle/
mobile/build/
mobile/app/build/
mobile/local.properties
mobile/.truststore.jks

# personal words the privacy check should refuse to ship (company, your own ideas)
scripts/privacy-words.txt

# generated at runtime from the code — never hand-written, never personal
workspace/AGENTS.md
workspace/CLAUDE.md
workspace/REMOTE_BRIEF.md

# promo material for Facebook: kept locally, never published
docs/PROMO-facebook.md
docs/img/facebook-post*.png

# local-only: scratch logs and skills installed for this machine's Claude Code
logs/
.claude/skills/

# internal market/competitor notes: kept local
docs/market/

# promo video sources and renders: kept local
video/
# generated by xcodegen from mobile-ios/project.yml
mobile-ios/*.xcodeproj/
